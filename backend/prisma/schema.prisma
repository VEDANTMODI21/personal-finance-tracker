// Personal Finance & Budget Tracker - Prisma Schema
// PostgreSQL database, camelCase fields mapped to snake_case columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  UPI
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  OTHER
}

enum IncomeSource {
  SALARY
  FREELANCE
  INTERNSHIP
  BONUS
  BUSINESS
  INVESTMENT
  GIFT
  OTHER
}

enum LoanStatus {
  OUTSTANDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  passwordHash      String   @map("password_hash")
  darkMode          Boolean  @default(false) @map("dark_mode")
  monthlyBudget     Decimal? @map("monthly_budget") @db.Decimal(12, 2)
  budgetAlertPct    Int      @default(90) @map("budget_alert_pct")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  categories        Category[]
  expenses          Expense[]
  incomes           Income[]
  loans             Loan[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  recurringExpenses RecurringExpense[]
  budgets           Budget[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Category {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  icon      String?
  color     String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Expense {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  categoryId    String        @map("category_id")
  amount        Decimal       @db.Decimal(12, 2)
  description   String
  date          DateTime
  paymentMethod PaymentMethod @map("payment_method")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, date])
  @@index([categoryId])
  @@map("expenses")
}

model Income {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  amount      Decimal      @db.Decimal(12, 2)
  source      IncomeSource
  description String?
  date        DateTime
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("incomes")
}

model Loan {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  personName String     @map("person_name")
  amount     Decimal    @db.Decimal(12, 2)
  dateGiven  DateTime   @map("date_given")
  dueDate    DateTime?  @map("due_date")
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@index([userId])
  @@map("loans")
}

model LoanPayment {
  id          String   @id @default(uuid())
  loanId      String   @map("loan_id")
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @map("payment_date")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("loan_payments")
}

model RecurringExpense {
  id            String               @id @default(uuid())
  userId        String               @map("user_id")
  categoryId    String?              @map("category_id")
  amount        Decimal              @db.Decimal(12, 2)
  description   String
  paymentMethod PaymentMethod        @map("payment_method")
  frequency     RecurrenceFrequency
  startDate     DateTime             @map("start_date")
  endDate       DateTime?            @map("end_date")
  lastRunDate   DateTime?            @map("last_run_date")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recurring_expenses")
}

model Budget {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  categoryId String?  @map("category_id")
  month      String   // format YYYY-MM
  limit      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("budgets")
}
