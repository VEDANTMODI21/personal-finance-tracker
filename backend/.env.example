PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/finance_tracker
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
BCRYPT_SALT_ROUNDS=10

# Optional — without any of these, forgot-password only works in
# development (it returns the reset token directly in the API response).
#
# Recommended: Brevo (brevo.com) — free forever (300 emails/day), no credit
# card, and works over HTTPS rather than raw SMTP. That last part matters if
# you're hosting on Render's free tier: Render blocks outbound SMTP ports
# (25/465/587) on free web services, which is exactly why Gmail SMTP below
# silently fails there no matter how correctly it's configured. Setup:
#   1. Sign up free at https://www.brevo.com (no card required).
#   2. Go to Senders, Domains & Dedicated IPs → Senders → Add a sender,
#      enter any email you own — Brevo emails you a verification code/link.
#      No domain or DNS setup needed, just that one email confirmed.
#   3. Go to SMTP & API → API Keys → Generate a new API key, copy it.
#   4. Set BREVO_API_KEY to that key, and EMAIL_FROM to the sender you just
#      verified, e.g. "Finance Tracker <you@example.com>".
BREVO_API_KEY=
EMAIL_FROM=Finance Tracker <you@example.com>

# Alternative: Gmail SMTP — free, and can email ANY recipient, but only
# usable if your host allows outbound SMTP (not Render's free tier — see
# above). Setup:
#   1. Use any Gmail account (a new free one is fine).
#   2. Turn on 2-Step Verification: myaccount.google.com/security
#   3. Create an App Password: myaccount.google.com/apppasswords
#      (choose "Mail" as the app) — copy the 16-character code it gives you.
#   4. Set GMAIL_USER to the Gmail address and GMAIL_APP_PASSWORD to that
#      16-character code (no spaces).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Alternative: Resend (resend.com, free tier, no card). Without verifying
# your own domain there, it can ONLY deliver to the email address your
# Resend account itself was signed up with — fine for solo testing, not for
# real users. Verify a domain in Resend's dashboard to lift that limit.
RESEND_API_KEY=
