PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/finance_tracker
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
BCRYPT_SALT_ROUNDS=10

# Optional — without these, forgot-password only works in development (it
# returns the reset token directly in the API response). Set both to send
# a real reset-link email in production. Sign up free at https://resend.com,
# create an API key, and you can send from onboarding@resend.dev with no
# domain setup required.
RESEND_API_KEY=
EMAIL_FROM=Finance Tracker <onboarding@resend.dev>
